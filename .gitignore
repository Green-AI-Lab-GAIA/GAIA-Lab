/.quarto/
_site/

# Bytecode do python: nasce a cada rodada e nao tem o que fazer no repositorio
__pycache__/
*.pyc

# Perfis do LinkedIn usados como fonte (dados pessoais, nao publicar)
/perfis/

# PDFs do LinkedIn dentro das pastas de membros (dados pessoais)
people/*/*.pdf

# Documentos locais e relatorios gerados
*.pdf
*.html
!docs/**/*.html
!_includes/**/*.html
!_ejs/**/*.html
readme.html
README.pdf
scripts/gerar_readme_pdf.py

# Dados locais sincronizados das planilhas e configuracoes de fontes
/dados/

# Ferramentas internas e scripts de automacao privada (Apps Script)
/ferramentas/
